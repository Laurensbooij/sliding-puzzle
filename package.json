{
  "name": "sliding-puzzle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "node scripts/build-tokens.mjs",
    "i18n:extract": "formatjs extract 'src/**/*.ts*' --ignore='**/*.d.ts' --format simple --out-file src/lib/i18n/locales/en.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cp": "git commit --no-verify -m CP",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@xstate/react": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intl": "^10.1.20",
    "xstate": "^5.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.16",
    "@storybook/addon-a11y": "^10.1.0",
    "@storybook/addon-docs": "^10.1.0",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "~4.1.10",
    "@vitest/browser-playwright": "~4.1.10",
    "@vitest/coverage-v8": "~4.1.0",
    "chromatic": "^17.6.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-formatjs": "^6.4.20",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-testing-library": "^7.13.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "storybook": "^10.1.0",
    "style-dictionary": "^5.5.1",
    "stylelint": "^16.26.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-declaration-strict-value": "^1.10.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{ts,tsx}": "eslint --fix",
    "*.css": "stylelint --fix"
  }
}
