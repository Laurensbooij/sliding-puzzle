{
	"useTabs": true,
	"printWidth": 100,
	"singleQuote": true,
	"semi": false,
	"endOfLine": "lf",
	"plugins": ["@trivago/prettier-plugin-sort-imports"],
	"importOrder": ["^[./]"],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"overrides": [
		{
			"files": ["*.json", "*.yml", "*.yaml", "*.md"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	]
}
